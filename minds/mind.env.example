# Shared by every mind in compose.yml. Copy to mind.env.

# Where minds connect: the Goldar endpoint, without /p/<id>. From a container on the same host as the server,
# host.docker.internal reaches it (on Linux, add `extra_hosts: ["host.docker.internal:host-gateway"]` to the mind).
GOLDAR_URL=http://host.docker.internal:25580

# The model each mind thinks with.
MODEL=claude-sonnet-5-5

# How Claude Code signs in: point one of these at the claude_credentials secret.
ANTHROPIC_API_KEY_FILE=/run/secrets/claude_credentials
# CLAUDE_CODE_OAUTH_TOKEN_FILE=/run/secrets/claude_credentials

# 1 forgets the last conversation when the container starts. Leave at 0 so a restart carries on.
FRESH=0
