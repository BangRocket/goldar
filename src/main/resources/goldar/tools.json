 {
  "name": "wait",
  "description": "Wait until something worth a decision happens, or max_seconds pass. Pass the cursor from the last result to see events you have not seen.",
  "inputSchema": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "description": "Wait until something worth a decision happens, or max_seconds pass. Pass the cursor from the last result to see events you have not seen.",
   "additionalProperties": false,
   "required": [
    "max_seconds"
   ],
   "properties": {
    "cursor": {
     "$ref": "#/$defs/McpCursor"
    },
    "interests": {
     "type": "array",
     "uniqueItems": true,
     "maxItems": 6,
     "description": "Event kinds that may end the wait. Default: all of them.",
     "items": {
      "$ref": "#/$defs/McpInterest"
     }
    },
    "max_seconds": {
     "type": "integer",
     "minimum": 5,
     "maximum": 240
    }
   },
   "$defs": {
    "McpCursor": {
     "type": "string",
     "pattern": "^c_[0-9]{1,12}$",
     "description": "An opaque position in a player's event log, as returned by wait."
    },
    "McpInterest": {
     "description": "An event kind that wait may wake for.",
     "enum": [
      "directly_addressed",
      "intent_finished",
      "damage",
      "agent_approached",
      "proposal",
      "day_night"
     ]
    }
   }
  }
 },
 {
